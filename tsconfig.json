{
  "include": ["src"],
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "moduleResolution": "bundler",

    "noEmit": true,

    "target": "esnext",
    "types": ["@types/web"],
    "lib": [
      "ESNext"
      // The TypeScript 7.0.2 DOM lib does not have WebGPU's bitflag namespaces.
      // `bun check` bundles TypeScript 7.0.2.
      // `@types/web`, a newer copy of the same lib, replaces it.
      // FIXME Restore "DOM" and remove `@types/web` when `bun check` bundles a
      // TypeScript release that includes this fix:
      // https://github.com/microsoft/TypeScript-DOM-lib-generator/pull/2469
      // "DOM"
    ]
  }
}
